---
import Base from '../../layouts/Base.astro';
import S from '../../data/series.json';
import ST from '../../data/stills.json';
import P from '../../data/posts.json';
import { headerHTML, seriesLD, SEL, seriesAlt } from '../../lib/site.mjs';

export function getStaticPaths() {
  return S.map((s, i) => ({ params: { slug: s.slug }, props: { i } }));
}
const { i } = Astro.props;
const s = S[i];
const prev = S[(i - 1 + S.length) % S.length];
const next = S[(i + 1) % S.length];
const kind = s.fmt.split(',')[0];
const clip = (t, n = 156) => (t.length <= n ? t : t.slice(0, t.lastIndexOf(' ', n - 1)).replace(/[,.;:]$/, '') + '...');
const title = `${s.t} | ${kind} directed by Nivedkrishna Thavarayil`;
const description = clip(`${s.t}: ${s.log}`);
const no = String(i + 1).padStart(2, '0');
const image = `/og/${s.slug}.jpg`;
const stills = ST.filter((x) => x.series === s.slug);
/* every article that links to this series */
const reads = [...P].filter((p) => JSON.stringify(p.body).includes(`/series/${s.slug}/`)).sort((a, b) => b.date.localeCompare(a.date));
const FORMAT = { take: 'Take', bts: 'Behind the scenes' };
const others = S.filter((x) => x.slug !== s.slug);
---
<Base
  title={title}
  description={description}
  ogTitle={`${s.t}, directed by Nivedkrishna Thavarayil`}
  path={`/series/${s.slug}/`}
  image={image}
  imageAlt={seriesAlt(s)}
  type="video.tv_show"
  jsonld={seriesLD(s, i)}
  page="series"
  preload={s.poster ? [{ href: s.poster, as: 'image' }] : []}
>
  <Fragment set:html={headerHTML} />
  <main id="top" class="sx">
    <div class="wrap sx-grid">
      <div class="sx-copy">
        <a class="sx-back" href="/#series">All twelve series</a>
        <p class="sx-no">No. {no} of {S.length}</p>
        <h1 class="d sx-t">{s.t}</h1>
        <p class="sx-by">{s.role.startsWith('Writer') ? 'Written and directed' : 'Directed'} by <a href="/" rel="author">Nivedkrishna Thavarayil</a></p>
        <p class="sx-log">{s.log}</p>
        {s.note && <p class="sx-note">{s.note}</p>}
        <dl class="sx-dl">
          <dt>Format</dt><dd>{s.fmt}</dd>
          <dt>My role</dt><dd>{s.role}</dd>
          {s.city && <><dt>Shot in</dt><dd>{s.city}</dd></>}
          <dt>For</dt><dd>Canvas by Bombay Canvas</dd>
          <dt>Status</dt><dd>{s.live ? <span class="mk sx-live">Streaming now<Fragment set:html={SEL} /></span> : 'Coming soon'}</dd>
        </dl>
        {s.cr && <p class="sx-cr">{s.cr}</p>}
        {s.link && <a class="btn solid sx-cta" href={s.link[1]}>{s.link[0]}</a>}
      </div>
      <div class={`sx-media${s.poster ? '' : ` card ${s.cls || ''}`}`} style={`view-transition-name:m-${s.slug}`}>
        {s.vid ? (
          <video src={s.vid} poster={s.poster} autoplay muted loop playsinline disablepictureinpicture preload="auto" aria-label={`Trailer for ${seriesAlt(s)}`}></video>
        ) : s.poster ? (
          <img src={s.poster} alt={`${s.t} key art`} width="540" height="960">
        ) : (
          <span class="ttl" aria-hidden="true">{s.t}</span>
        )}
      </div>
    </div>
    {stills.length > 0 && (
      <section class="wrap sx-sec" aria-labelledby="st-h">
        <h2 class="cs-h" id="st-h">Stills</h2>
        <div class="sx-stills">
          {stills.map((x) => <figure><picture><source type="image/webp" srcset={x.src.replace(/\.jpg$/, '.webp')} /><img src={x.src} alt={x.alt} width={x.w} height={x.h} loading="lazy" decoding="async" /></picture></figure>)}
        </div>
      </section>
    )}
    {reads.length > 0 && (
      <section class="wrap sx-sec" aria-labelledby="rd-h">
        <h2 class="cs-h" id="rd-h">{reads.length > 1 ? 'Read more about it' : 'Read the story'}</h2>
        <ul class="lib-grid sx-reads">
          {reads.map((p) => (
            <li><a class={`cscard take${p.cover ? ' has-img' : ''}`} href={`/work/${p.slug}/`} style={`--c:${p.color}`}>
              {p.cover && <span class="cscard-img" aria-hidden="true"><img src={p.cover.src} alt="" loading="lazy" decoding="async" /></span>}
              <span class="cscard-b">{FORMAT[p.format]}, {p.topic}</span>
              <span class="cscard-mid"><span class="cscard-h d">{p.title}</span></span>
              <span class="cscard-t">{p.dek}</span>
              <span class="cscard-go">Read it, {p.read.replace(' read', '')}</span>
            </a></li>
          ))}
        </ul>
      </section>
    )}
    <section class="wrap sx-sec" aria-labelledby="all-h">
      <h2 class="cs-h" id="all-h">More series I directed</h2>
      <ul class="sx-all">{others.map((x) => <li><a href={`/series/${x.slug}/`}>{x.t}</a> <span>{x.fmt.split(',')[0]}, {x.city}</span></li>)}</ul>
    </section>
    <nav class="wrap sx-more" aria-label="More series">
      <a class="sx-pn" href={`/series/${prev.slug}/`} rel="prev"><span>Previous</span><b class="d">{prev.t}</b></a>
      <a class="sx-pn nx" href={`/series/${next.slug}/`} rel="next"><span>Next</span><b class="d">{next.t}</b></a>
    </nav>
  </main>
  <footer class="dark endmark sx-end">
    <p class="wm big" data-fit aria-hidden="true"><span>N<span class="idot">ı</span>vedkrishna</span> <span>Thavarayil</span></p>
    <div class="wrap endrow"><span>Nivedkrishna Thavarayil, Creative Strategist and Director. New York and Jersey City, 2026.</span><a class="again" href="/#contact">Work with me</a></div>
  </footer>
  <script>
    import '../../scripts/motion.js';
  </script>
</Base>
