---
import Base from '../../layouts/Base.astro';
import P from '../../data/posts.json';
import C from '../../data/cases.json';
import { headerHTML, SITE, PERSON, shareHTML } from '../../lib/site.mjs';

/* takes and behind-the-scenes pieces share /work/<slug>/ with the case studies */
export function getStaticPaths() {
  return P.map((p) => ({ params: { post: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const url = `${SITE}/work/${p.slug}/`;
const FORMAT = { take: 'Take', bts: 'Behind the scenes' };
const rel = C.find((c) => c.slug === p.related);
const esc = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/* body text may carry [label](https://link) */
const md = (t) => esc(t).replace(/\[([^\]]+)\]\(((?:https?:|\/)[^)\s]*)\)/g, '<a href="$2">$1</a>');
const plain = (t) => (Array.isArray(t) ? t.join(' ') : String(t)).replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const first = plain(p.body.find((b) => b[0] === 'p')[1]);
const ogImg = `/og/work-${p.slug}.jpg?v=3`;
/* keep reading: pieces that share a series, a topic or a format with this one */
const links = (x) => new Set((JSON.stringify(x.body).match(/\/series\/[a-z0-9-]+\//g) || []));
const mine = links(p);
const more = P.filter((x) => x.slug !== p.slug)
  .map((x) => ({ x, s: [...links(x)].filter((l) => mine.has(l)).length * 3 + (x.topic === p.topic ? 2 : 0) + (x.format === p.format ? 1 : 0) }))
  .sort((a, b) => b.s - a.s || b.x.date.localeCompare(a.x.date))
  .slice(0, 3).map((o) => o.x);
const share = (id, label, compact = false) => shareHTML(url, `${p.title.replace(/\.$/, '')}. ${p.dek}`, { id, label, compact });
const description = `${p.title.replace(/\.$/, '')}: ${p.dek.replace(/\.$/, '')}. ${first}`.slice(0, 155).replace(/\s+\S*$/, '') + '...';
const TEXT = ['p', 'h2', 'quote', 'ul'];
const words = p.body.filter((b) => TEXT.includes(b[0])).reduce((n, b) => n + plain(b[1]).split(/\s+/).length, 0);
/* self-hosted videos in the body get VideoObject data so they can show up in Google video results */
const videos = p.body.filter((b) => b[0] === 'video').map((b) => ({
  '@type': 'VideoObject',
  name: b[1].title,
  description: plain(b[1].cap),
  thumbnailUrl: `${SITE}${b[1].poster}`,
  contentUrl: `${SITE}${b[1].src}`,
  uploadDate: p.date,
  duration: b[1].dur,
  embedUrl: url,
  creator: { '@id': PERSON['@id'] },
}));
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${url}#article`,
      headline: `${p.title.replace(/\.$/, '')} ${p.dek}`,
      description,
      url,
      image: `${SITE}${ogImg}`,
      datePublished: p.date,
      wordCount: words,
      articleSection: FORMAT[p.format],
      keywords: [p.topic, 'creative strategy', 'Nivedkrishna Thavarayil', p.format === 'bts' ? 'behind the scenes' : 'marketing'],
      author: { '@id': PERSON['@id'] },
      publisher: { '@id': PERSON['@id'] },
      mainEntityOfPage: url,
      ...(p.origin ? { sameAs: p.origin[1] } : {}),
      ...(p.audio ? { audio: { '@type': 'AudioObject', contentUrl: `${SITE}${p.audio.src}`, encodingFormat: 'audio/mpeg', duration: p.audio.dur, name: `${p.title.replace(/\.$/, '')} (audio)` } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Work', item: `${SITE}/work/` },
        { '@type': 'ListItem', position: 3, name: p.short, item: url },
      ],
    },
    ...videos,
    PERSON,
  ],
};
---
<Base
  title={`${p.title.replace(/\.$/, '')} | Nivedkrishna Thavarayil`}
  description={description}
  ogTitle={`${p.title} ${p.dek}`}
  path={`/work/${p.slug}/`}
  image={ogImg}
  imageAlt={`${p.title} ${p.dek} ${FORMAT[p.format]} by Nivedkrishna Thavarayil`}
  type="article"
  jsonld={ld}
  page="case"
>
  <Fragment set:html={headerHTML} />
  <main id="top" class="cs post">
    <article>
      <header class="wrap cs-head">
        <a class="sx-back" href="/work/">All work</a>
        <p class="cs-kick">{FORMAT[p.format]}, {p.topic}</p>
        <h1 class="d sx-t cs-t">{p.title}</h1>
        <p class="cs-line">{p.dek}</p>
        <p class="post-by">By <a href="/" rel="author">Nivedkrishna Thavarayil</a>. {p.dateLabel}. {p.read}.{p.origin && <> <a href={p.origin[1]}>Also on LinkedIn</a>.</>}{!p.audio && <> <button type="button" class="post-listen" id="listen" hidden>Listen to this</button></>}</p>
        {p.audio && <figure class="post-audio"><audio controls preload="none" src={p.audio.src}></audio><figcaption>Listen: read by Nivedkrishna Thavarayil, {p.audio.label}. Also on the <a href="/podcast.xml">podcast feed</a>.</figcaption></figure>}
        <Fragment set:html={share('share-top', 'Share', true)} />
      </header>
      {p.cover && (
        <figure class="wrap post-cover">
          <img src={p.cover.src} width={p.cover.w} height={p.cover.h} alt={p.cover.alt} fetchpriority="high" decoding="async" style={`max-width:${p.cover.w}px`} />
          {p.cover.cap && <figcaption set:html={md(p.cover.cap)} />}
        </figure>
      )}
      <div class="wrap post-body">
        {p.body.map(([t, v]) =>
          t === 'h2' ? <h2 class="post-h">{v}</h2> :
          t === 'quote' ? <blockquote class="post-q d">{v}</blockquote> :
          t === 'ul' ? <ul class="post-ul">{v.map((li) => <li set:html={md(li)} />)}</ul> :
          t === 'video' ? <figure class="post-video"><video controls playsinline preload="none" poster={v.poster} width={v.w} height={v.h} aria-label={v.label}><source src={v.src} type="video/mp4" /></video><figcaption set:html={md(v.cap)} /></figure> :
          t === 'gallery' ? <div class={v.every((g) => g.w / g.h > 1.8) ? 'post-gal wide' : 'post-gal'}>{v.map((g) => <figure><picture><source type="image/webp" srcset={g.src.replace(/\.jpg$/, '.webp')} /><img src={g.src} alt={g.alt} width={g.w} height={g.h} loading="lazy" decoding="async" /></picture><figcaption set:html={md(g.cap)} /></figure>)}</div> :
          t === 'reels' ? <ul class="cs-reels post-reels" style={`--n:${Math.min(v.length, 4)}`}>{v.map((r) => <li><a class="reel" href={`https://www.instagram.com/reel/${r.ig}/`} data-ig={r.ig} data-title={`${r.t}, ${r.v} views`} data-label={`${r.t}, from ${p.short} by Nivedkrishna Thavarayil`}><picture><source type="image/webp" srcset={`/media/reels/${r.ig}.webp`} /><img src={`/media/reels/${r.ig}.jpg`} alt={r.alt} width="360" height="640" loading="lazy" decoding="async" /></picture><span class="reel-v"><b class="d">{r.v}</b> views</span><span class="vh">Play the reel</span></a><p class="reel-t">{r.t}<span>{r.by}</span></p></li>)}</ul> :
          t === 'yt' ? <p class="post-yt"><a class="watch" href={`https://www.youtube.com/watch?v=${v[0]}`} data-yt={v[0]} data-title={v[1]} data-label={v[2]}>{v[3]}</a></p> :
          <p set:html={md(v)} />
        )}
      </div>
      <div class="wrap post-end">
        <Fragment set:html={share('share-end', 'Liked it? Pass it on.')} />
        {p.origin && <p class="post-talk"><a href={p.origin[1]}>Join the conversation on LinkedIn</a></p>}
      </div>
      {rel && (
        <aside class="wrap post-rel" aria-labelledby="rel-h">
          <h2 class="cs-h" id="rel-h">The campaign behind this</h2>
          <a class="cscard" href={`/work/${rel.slug}/`} style={`--c:${rel.color}`}>
            <span class="cscard-b">{rel.brand}</span>
            <span class="cscard-mid"><span class="cscard-n d">{rel.stat}</span><span class="cscard-c">{rel.statCap}</span></span>
            <span class="cscard-t">{rel.title}</span>
            <span class="cscard-go">Read the case study</span>
          </a>
        </aside>
      )}
      {more.length > 0 && (
        <aside class="wrap post-more" aria-labelledby="more-h">
          <h2 class="cs-h" id="more-h">Keep reading</h2>
          <ul class="lib-grid">
            {more.map((x) => (
              <li><a class={`cscard take${x.cover ? ' has-img' : ''}`} href={`/work/${x.slug}/`} style={`--c:${x.color}`}>
                {x.cover && <span class="cscard-img" aria-hidden="true"><img src={x.cover.src} alt="" loading="lazy" decoding="async" /></span>}
                <span class="cscard-b">{FORMAT[x.format]}, {x.topic}</span>
                <span class="cscard-mid"><span class="cscard-h d">{x.title}</span></span>
                <span class="cscard-t">{x.dek}</span>
                <span class="cscard-go">Read it, {x.read.replace(' read', '')}</span>
              </a></li>
            ))}
          </ul>
        </aside>
      )}
      <section class="wrap cs-sec cs-cta post-cta" aria-labelledby="next-step">
        <h2 class="cs-h" id="next-step">Want this thinking on your brand?</h2>
        <p class="acts2"><a class="btn solid2" href="https://calendly.com/nivedkrishnathavarayil/30min">Book a 30-minute call</a><a class="btn" href="/Nivedkrishna-Thavarayil-Resume.pdf" target="_blank" rel="noopener">Download my resume</a></p>
      </section>
    </article>
    <nav class="wrap sx-more cs-more" aria-label="More work">
      <a class="sx-pn" href="/work/"><span>Everything in one place</span><b class="d">All work</b></a>
      {rel && <a class="sx-pn nx" href={`/work/${rel.slug}/`}><span>Case study</span><b class="d">{rel.short}</b></a>}
    </nav>
  </main>
  <footer class="dark endmark sx-end">
    <p class="wm big" data-fit aria-hidden="true"><span>N<span class="idot">ı</span>vedkrishna</span> <span>Thavarayil</span></p>
    <div class="wrap endrow"><span>Nivedkrishna Thavarayil, Creative Strategist and Director. New York and Jersey City, 2026.</span><a class="again" href="/#contact">Work with me</a></div>
  </footer>
  <script>
    import '../../scripts/motion.js';
  </script>
</Base>
