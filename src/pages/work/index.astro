---
import Base from '../../layouts/Base.astro';
import C from '../../data/cases.json';
import P from '../../data/posts.json';
import { headerHTML, SITE, PERSON } from '../../lib/site.mjs';
import { existsSync } from 'node:fs';
import { imageSize } from '../../lib/imgsize.mjs';

/* a 720px WebP twin (name-card.webp) serves the small card; the original stays as the large fallback */
const cardSet = (src) => {
  const small = src.replace(/\.(jpe?g|png)$/i, '-card.webp');
  if (small === src || !existsSync(`public${small}`)) return {};
  const w = imageSize(`public${src}`);
  return { src: small, srcset: `${small} 720w${w ? `, ${src} ${w}w` : ''}`, sizes: '(max-width: 700px) 92vw, 420px' };
};

/* one library: case studies first (the proof), then takes and behind-the-scenes pieces, newest first */
const FORMAT = { case: 'Case study', take: 'Take', bts: 'Behind the scenes' };
const PLURAL = { case: 'Case studies', take: 'Takes', bts: 'Behind the scenes' };
const items = [
  ...C.map((c) => ({ kind: 'case', slug: c.slug, color: c.color, label: c.brand, stat: c.stat, cap: c.statCap, title: c.title, go: 'Read the case study', name: c.short })),
  ...[...P].sort((a, b) => b.date.localeCompare(a.date)).map((p) => ({ kind: p.format, slug: p.slug, color: p.color, label: `${FORMAT[p.format]}, ${p.topic}`, title: p.title, dek: p.dek, img: p.cover && p.cover.card !== false && p.cover.src, pos: p.cover && p.cover.pos, imgAlt: p.cover && p.cover.alt, go: `Read the ${p.format === 'take' ? 'take' : 'story'}, ${p.read.replace(' read', '')}`, name: p.short })),
];
const kinds = ['case', 'take', 'bts'].filter((k) => items.some((it) => it.kind === k));
const url = `${SITE}/work/`;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': url,
      url,
      name: 'Work by Nivedkrishna Thavarayil',
      about: { '@id': PERSON['@id'] },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: items.map((it, k) => ({ '@type': 'ListItem', position: k + 1, url: `${SITE}/work/${it.slug}/`, name: it.name })),
      },
    },
    PERSON,
  ],
};
---
<Base
  title="Work: case studies, takes and behind the scenes | Nivedkrishna Thavarayil"
  description="Every campaign, series and shoot by Nivedkrishna Thavarayil, Creative Strategist and Director in New York: case studies with the numbers, takes on what worked, and how it was made."
  ogTitle="Work by Nivedkrishna Thavarayil"
  image="/og/work.jpg"
  imageAlt="Work by Nivedkrishna Thavarayil, Creative Strategist and Director in New York: stills from The Last Pizza with Nathan Flores, Agent X with Dillon Cain and Nathan Flores, and Demo Day, the Canvas series he directed"
  path="/work/"
  jsonld={ld}
  page="case"
>
  <Fragment set:html={headerHTML} />
  <main id="top" class="cs lib">
    <header class="wrap cs-head">
      <a class="sx-back" href="/">Home</a>
      <p class="cs-kick">Work</p>
      <h1 class="d sx-t cs-t">Everything I've made, and what it taught me.</h1>
      <p class="cs-line">Case studies with the numbers, takes on what worked, and the story of how it was made. New pieces land here first.</p>
    </header>
    <div class="wrap lib-wrap">
      {kinds.length > 1 && (
        <div class="lib-f" role="group" aria-label="Show">
          <button type="button" data-f="all" aria-pressed="true">All <span>{items.length}</span></button>
          {kinds.map((k) => <button type="button" data-f={k} aria-pressed="false">{PLURAL[k]} <span>{items.filter((it) => it.kind === k).length}</span></button>)}
        </div>
      )}
      <ul class="lib-grid">
        {items.map((it) => (
          <li data-kind={it.kind}>
            <a class={`cscard${it.kind === 'case' ? '' : ' take'}${it.img ? ' has-img' : ''}`} href={`/work/${it.slug}/`} style={`--c:${it.color}`}>
              {it.img && <span class="cscard-img" aria-hidden="true"><img {...{ src: it.img, ...cardSet(it.img) }} alt={it.imgAlt || ''} loading="lazy" decoding="async" style={it.pos ? `object-position:${it.pos}` : undefined} /></span>}
              <span class="cscard-b">{it.label}</span>
              {it.kind === 'case'
                ? <span class="cscard-mid"><span class="cscard-n d">{it.stat}</span><span class="cscard-c">{it.cap}</span></span>
                : <span class="cscard-mid"><span class="cscard-h d">{it.title}</span></span>}
              <span class="cscard-t">{it.kind === 'case' ? it.title : it.dek}</span>
              <span class="cscard-go">{it.go}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <footer class="dark endmark sx-end">
    <p class="wm big" data-fit aria-hidden="true"><span>N<span class="idot">ı</span>vedkrishna</span> <span>Thavarayil</span></p>
    <div class="wrap endrow"><span>Nivedkrishna Thavarayil, Creative Strategist and Director. New York and Jersey City, 2026.</span><a class="again" href="/#contact">Work with me</a></div>
  </footer>
  <script>
    import '../../scripts/motion.js';
    /* filter chips: one press shows one kind of piece; All brings everything back */
    const bar = document.querySelector('.lib-f');
    if (bar) {
      const lis = [...document.querySelectorAll('.lib-grid > li')];
      bar.addEventListener('click', (e) => {
        const b = e.target.closest('button[data-f]');
        if (!b) return;
        bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        lis.forEach((li) => { li.hidden = b.dataset.f !== 'all' && li.dataset.kind !== b.dataset.f; });
      });
    }
  </script>
</Base>
