---
import Base from '../layouts/Base.astro';
import { headerHTML, SITE, PERSON } from '../lib/site.mjs';

const CAL = 'https://calendly.com/nivedkrishnathavarayil/30min';
const url = `${SITE}/work-with-me/`;
const places = ['New York City', 'New Jersey', 'Los Angeles', 'San Francisco'];

/* each service: the name people search for, one line, what you get, and where the proof lives */
const services = [
  {
    id: 'strategy',
    name: 'Creative strategy and paid social',
    line: 'Hooks, angles, test plans and briefs, then the ads themselves on Meta, TikTok and YouTube.',
    get: [
      'A content system built on hub, hype and hygiene posts',
      'Paid campaigns with offers tied to a real moment',
      'Captions written around what people actually search',
    ],
    proof: [
      ['Frangos at the World Cup', '/work/frangos-world-cup/'],
      ['Fetchy, 616,000 views on one Short', '/work/fetchy/'],
    ],
  },
  {
    id: 'video',
    name: 'Short-form video and series',
    line: 'Reels, Shorts, branded series and micro-dramas, written, shot, directed and cut for the screen in your hand.',
    get: [
      'Three-to-four-day shoots with a plan for every cut',
      'Edits for each platform, not one edit stretched across all of them',
      'A launch that starts before the shoot does',
    ],
    proof: [
      ['12 series directed for Canvas', '/#series'],
      ['Brick Lane, 1.5M views on one reel', '/work/brick-lane-phaal/'],
    ],
  },
  {
    id: 'ai',
    name: 'AI video production',
    line: 'AI built into the pipeline, not bolted on at the end.',
    get: [
      'Directure AI to plan shoots, some planned one day and shot the next',
      'Claude Code agents wired into Premiere Pro, Higgsfield and ElevenLabs for edits, animation, infographics and AI video',
      'Gemini to read which hooks are working, and posting that runs on its own',
    ],
    proof: [['Most Canvas series were planned in Directure AI', '/#series']],
    note: 'This website was built with Claude Code.',
  },
  {
    id: 'brand',
    name: 'Brand, creator and influencer marketing',
    line: 'Creators pitched personally, and partnerships that keep posting after the deal is done.',
    get: [
      'Creator and meme-page partnerships',
      'Brand identities, launches and merch',
      'Restaurants, founders, fashion, luxury and jewelry brands',
    ],
    proof: [
      ['Infamous Coconuts, 19.2M views', '/work/infamous-coconuts/'],
      ['All five case studies', '/#cases'],
    ],
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: 'Work with Nivedkrishna Thavarayil',
      about: { '@id': `${SITE}/#person` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
          { '@type': 'ListItem', position: 2, name: 'Work with me', item: url },
        ],
      },
    },
    {
      '@type': 'ItemList',
      name: 'Services',
      itemListElement: services.map((s, k) => ({
        '@type': 'ListItem',
        position: k + 1,
        item: {
          '@type': 'Service',
          '@id': `${url}#${s.id}`,
          name: s.name,
          description: `${s.line} ${s.get.join('. ')}.`,
          provider: { '@id': `${SITE}/#person` },
          areaServed: places.map((p) => ({ '@type': 'Place', name: p })),
        },
      })),
    },
    PERSON,
  ],
};
---
<Base
  title="Creative Strategist and Video Director in New York | Nivedkrishna Thavarayil"
  description="Creative strategy, paid social, short-form video and AI video production for brands in New York, New Jersey, Los Angeles and San Francisco. Book a 30-minute call."
  ogTitle="Work with Nivedkrishna Thavarayil"
  path="/work-with-me/"
  jsonld={ld}
  page="case"
>
  <Fragment set:html={headerHTML} />
  <main id="top" class="cs ww">
    <header class="wrap cs-head">
      <a class="sx-back" href="/">Home</a>
      <p class="cs-kick">Work with me</p>
      <h1 class="d sx-t cs-t">Strategy, short-form video and AI, from one desk.</h1>
      <p class="cs-line">For brands, founders and studios in New York, New Jersey, Los Angeles and San Francisco. One person from the brief to the boosted post.</p>
      <p class="acts2"><a class="btn solid2" href={CAL}>Book a 30-minute call</a><a class="btn" href="mailto:nivedkrishnathavarayil@gmail.com">Email me</a></p>
    </header>
    <div class="wrap cs-body">
      {services.map((s) => (
        <section class="cs-sec ww-svc" id={s.id} aria-labelledby={`${s.id}-h`}>
          <h2 class="cs-h" id={`${s.id}-h`}>{s.name}</h2>
          <div>
            <p class="ww-line">{s.line}</p>
            <ul class="ww-get">{s.get.map((g) => <li>{g}</li>)}</ul>
            <p class="ww-proof">{s.proof.map((p, k) => <>{k > 0 && <span aria-hidden="true"> / </span>}<a href={p[1]}>{p[0]}</a></>)}</p>
            {s.note && <p class="cs-src">{s.note}</p>}
          </div>
        </section>
      ))}
      <section class="cs-sec" aria-labelledby="where">
        <h2 class="cs-h" id="where">Where I work</h2>
        <p class="ww-line">New York City and New Jersey in person. Los Angeles, San Francisco, Boston and Baltimore on location, where the Canvas series were filmed. Anywhere else, remote.</p>
      </section>
      <section class="cs-sec cs-cta" aria-labelledby="start">
        <h2 class="cs-h" id="start">Start with a call</h2>
        <div>
          <p class="ww-line">Thirty minutes. Bring the brief, the problem or just the brand.</p>
          <p class="acts2"><a class="btn solid2" href={CAL}>Book a 30-minute call</a><a class="btn" href="/#cases">Read the case studies</a><a class="btn" href="/Nivedkrishna-Thavarayil-Resume.pdf" target="_blank" rel="noopener">Download my resume</a></p>
        </div>
      </section>
    </div>
  </main>
  <footer class="dark endmark sx-end">
    <p class="wm big" data-fit aria-hidden="true"><span>N<span class="idot">ı</span>vedkrishna</span> <span>Thavarayil</span></p>
    <div class="wrap endrow"><span>Nivedkrishna Thavarayil, Creative Strategist and Director. New York and Jersey City, 2026.</span><a class="again" href="/#contact">Contact</a></div>
  </footer>
  <script>
    import '../scripts/motion.js';
  </script>
</Base>
